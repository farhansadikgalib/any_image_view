# NOTE: when a .pubignore exists, pub uses it INSTEAD of .gitignore for this
# directory, so build output and tool caches must be listed here explicitly or
# they end up in the published archive.
build/
.dart_tool/
.idea/
.DS_Store
*.iml
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
.metadata

# Marketing images that nothing references (only raw/banner.png is used).
raw/ss.png
raw/gif.gif

# Local planning/design artifacts and logs (not user-facing docs).
docs/
logs/

# Claude Code instructions — internal contributor guide, not for pub.dev.
CLAUDE.md
.claude/

# README screenshots are served from GitHub, not needed in the archive.
raw/screenshots/
